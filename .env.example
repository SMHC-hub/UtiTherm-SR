# ==============================================================================
# UtiTherm-SR — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before running local scripts outside Docker:
#   cp .env.example .env

# Deterministic cuBLAS workspace allocation (mandatory for reproducible evaluation)
# Required by scripts/evaluate_bicubic_first_deterministic_step11g.py and step11l
CUBLAS_WORKSPACE_CONFIG=:4096:8

# Python path configuration
PYTHONPATH=/workspace:/workspace/src

# CPU thread limits for deterministic / bounded CPU preprocessing
OMP_NUM_THREADS=4
OPENBLAS_NUM_THREADS=4
MKL_NUM_THREADS=4

# Target GPU device (default: 0)
CUDA_VISIBLE_DEVICES=0
